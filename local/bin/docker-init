#!/bin/sh

set -e

DOCKER_ARCH=
case "$(uname -m)" in
	x86_64)  DOCKER_ARCH="x64" ;;
	aarch64) DOCKER_ARCH="aarch64" ;;
	armv7l)  DOCKER_ARCH="armhf" ;;
esac

BASE_PACKAGES="alpine-conf bash bash-completion alpine-sdk linux-headers bison flex vim diffutils file lsof openssh-client sudo autoconf automake libtool gdb bc ncurses ncurses-dev openssl openssl-dev xz elfutils elfutils-dev elfutils-libelf squashfs-tools mkinitfs xorriso mtools dosfstools grub-efi grep less e2fsprogs btrfs-progs wget ca-certificates arch-install-scripts debootstrap"

if [ "${DOCKER_ARCH}" = "x64" ]; then
	BASE_PACKAGES="${BASE_PACKAGES} syslinux"
fi

docker-install -r -u -c su-exec ${BASE_PACKAGES}

rm -rf /build
mkdir -p /build

mkdir -p /build/glibc
cd /build/glibc
DEBIAN_ARH=
if [ "${DOCKER_ARCH}" = "x64" ]; then
	DEBIAN_ARCH=amd64
elif [ "${DOCKER_ARCH}" = "armhf" ]; then
	DEBIAN_ARCH=armhf
elif [ "${DOCKER_ARCH}" = "aarch64" ]; then
	DEBIAN_ARCH=arm64
fi
wget --no-check-certificate http://ftp.kr.debian.org/debian/dists/sid/main/binary-${DEBIAN_ARCH}/Packages.gz -q

for x in libc-bin libc-dev-bin libc-l10n libc6 libc6-dev locales
do
	echo ${x}
	wget --no-check-certificate "$(zcat Packages.gz | grep "Filename: pool/main/g/glibc/${x}_.*.deb" | sed -e "s@^.*Filename: @http://ftp.kr.debian.org/debian/\1@g")" -q
	ar -xf ${x}*.deb
	tar Jxf data.tar.xz
	rm -rf ${x}*.deb debian-binary control.tar.xz data.tar.xz
done
mkdir -p usr/inc
mv usr/include usr/inc/glibc
mv usr/inc usr/include
rm -rf Packages.gz

find . -type f -or -type l | while read -r f
do
	dir="$(dirname ${f})"
	mkdir -p /${dir}
	if [ ! -e /${f} ]; then
		cp -a ${f} /${dir}/
	else
		echo "Alread exists ${f}"
		#cp -a ${f} /${dir}/$(basename "${f}")_glibc
	fi
done

cd /

rm -rf /build

if [ "${DOCKER_ARCH}" = "aarch64" -o "${DOCKER_ARCH}" = "armhf" ]; then
	qemu=
	if [ "${DOCKER_ARCH}" = "aarch64" ]; then
		qemu=qemu-aarch64-static
	elif [ "${DOCKER_ARCH}" = "armhf" ]; then
		qemu=qemu-arm-static
	fi
	if [ ! -z "${qemu}" -a -e /usr/bin/${qemu} ]; then
		cp /usr/bin/${qemu} /usr/local/bin/
		chmod 4755 /usr/local/bin/${qemu}

		cat << EOF > /usr/local/bin/sudo
#!/bin/sh

qemu=/usr/local/bin/${qemu}
sudo=/usr/bin/sudo

if grep -q -w lm /proc/cpuinfo ; then
	if [ "\$(basename "\${0}")" = "sudoedit" ]; then
		\${qemu} -execve -0 /bin/sh \${sudo} -e "\${@}"
	else
		\${qemu} -execve -0 /bin/sh \${sudo} "\${@}"
	fi
else
	if [ "\$(basename "\${0}")" = "sudoedit" ]; then
		\${sudo} -e "\${@}"
	else
		\${sudo} "\${@}"
	fi
fi

exit \$?
EOF
		chmod 4755 /usr/local/bin/sudo
		ln -s sudo /usr/local/bin/sudoedit
	fi
fi

sed -i -e "s@^\(root:.*\):/bin/ash\$@\1:/bin/bash@g" /etc/passwd

sed -i -e 's/$(id -u) -eq 0/$(id -u) -eq -1/g' /usr/bin/abuild

ln -s /usr/bin/vim /usr/local/bin/vi

mkdir -p /etc/sudoers.d
ln -sf /usr/local/etc/sudoers /etc/sudoers.d/sudoers

